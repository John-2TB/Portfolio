---
---

<div class="flex items-center justify-around flex-col md:flex-row gap-8">
	<div id="hero-content">
		<h1 id="hero-title" class="text-3xl font-bold">HELLO, I'M JOHN<span id="waving-hand" class="inline-block">
			👋
			</span>
		</h1>
		<p class="text-lg pl-4 text-espresso/60">Koto Temiloluwa John</p>
		<p>I'm a <span id="typed-text" class="font-semibold font-mono text-caramel italic"></span></p>
		<div>
			<p class="text-5xl font-bold leading-18">
				I build digital<br><span class="text-caramel italic">experiences.</span>
			</p>
		</div>
		<div class="mt-4 flex space-x-4">
			<button class="bg-espresso text-white px-4 py-2 rounded-3xl hover:bg-espresso/80 cursor-pointer transition-all duration-250">View Projects</button>
			<button class="border border-espresso text-caramel px-4 py-2 rounded-3xl hover:bg-caramel hover:text-white transition-all duration-250 cursor-pointer">Contact Me</button>
		</div>
	</div>

	<div class="mt-8" id="hero-image">
		<img src="/profile-pic.jpg" alt="Hero Image" class="w-full max-w-md mx-auto rounded-[50%] shadow-lg" />
	</div>
</div>

	<script>
	import Typed from "typed.js";
	import gsap from 'gsap';
	import { SplitText } from 'gsap/SplitText';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(SplitText);
	gsap.registerPlugin(ScrollTrigger);

	new Typed("#typed-text", {
		strings: [
			'Software Engineer',
			'Web Developer',
			'Backend Developer',
			'Frontend Developer',
			'Full Stack Developer',
		],
		typeSpeed: 50,
		backSpeed: 50,
		backDelay: 1500,
		loop: true
	});

	const rotateHand = () => {
		gsap.to('#waving-hand', {
			rotation: 25,
			duration: 0.35,
			repeat: 4,
			yoyo: true,
			ease: 'power1.inOut',
			repeatDelay: 0.2
		})
	};

	rotateHand();

	const heroTimeline = gsap.timeline();

	if (document.querySelector('#header')) {
		heroTimeline.from('#header',
			{ y: -80, opacity: 0, duration: 0.7},
		);
	}

	const splitText = new SplitText('#hero-title', { type: 'chars' });

	heroTimeline.from(splitText.chars,
		{ y: 40, opacity: 0, stagger: 0.04, duration: 0.5 },
		"-=0.2"
	);

	heroTimeline.from("#hero-content > p", {
		y: 20,
		opacity: 0,
		stagger: 0.2,
		duration: 0.5
	});

	heroTimeline.from("#hero-content > div", {
		y: 20,
		opacity: 0,
		stagger: 0.2,
		duration: 0.5
	});

	heroTimeline.from("#hero-image", {
		y: 20,
		opacity: 0,
		duration: 0.5
	}, "-=0.3");
</script>