---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
---

<BaseLayout>
	<Hero />
	<About />
</BaseLayout>

<script>
	import Typed from "typed.js";
	import gsap from 'gsap';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(SplitText);

	new Typed("#typed-text", {
		strings: [
			'Software Engineer',
			'Web Developer',
			'Backend Developer',
			'Frontend Developer',
			'Full Stack Developer',
		],
		typeSpeed: 50,
		backSpeed: 50,
		backDelay: 1500,
		loop: true
	});

	const rotateHand = () => {
		gsap.to('#waving-hand', {
			rotation: 25,
			duration: 0.35,
			repeat: 4,
			yoyo: true,
			ease: 'power1.inOut',
			repeatDelay: 0.2
		})
	};

	setInterval(rotateHand, 5000);

	const heroTimeline = gsap.timeline();

	heroTimeline.fromTo('#header',
		{ y: -100, opacity: 0 },
		{ y: 0, opacity: 1, duration: 0.5, ease: 'power2.out' }
	);

	const splitText = new SplitText('#hero', { type: 'lines' });

	heroTimeline.fromTo(splitText.lines,
		{ y: 50, opacity: 0 },
		{ y: 0, opacity: 1, duration: 0.5, stagger: 0.6, ease: 'power2.out' }
	);
</script>