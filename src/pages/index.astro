---
import BaseLayout from '../layouts/BaseLayout.astro';
import Typed from 'typed.js';
---

<BaseLayout>
	<div>
		<h1 class="text-4xl font-bold">I'm John</h1>
		<p class="text-lg pl-2">Koto Temiloluwa John</p>
		<span id="typed-text" class="text-3xl font-semibold font-serif text-caramel"></span>
	</div>
</BaseLayout>

<script>
	import Typed from "typed.js";
	new Typed("#typed-text", {
		strings: [
			'Software Engineer',
			'Web Developer',
			'Backend Developer',
			'Frontend Developer',
			'Full Stack Developer',
		],
		typeSpeed: 50,
		backSpeed: 50,
		backDelay: 1000,
		loop: true
	});
</script>