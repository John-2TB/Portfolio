---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<div id="hero" class="flex items-center justify-between flex-col md:flex-row gap-8">
		<div>
			<h1 class="text-3xl font-bold">HELLO, I'M JOHN<span id="waving-hand" class="inline-block">
				👋
				</span>
			</h1>
			<p class="text-lg pl-4 text-espresso/60">Koto Temiloluwa John</p>
			<p>I'm a <span id="typed-text" class="font-semibold font-mono text-caramel italic"></span></p>
			<div class="">
				<p class="text-5xl font-bold leading-18">
					I build digital<br><span class="text-caramel italic">experiences.</span>
				</p>
			</div>
			<div class="mt-4 flex space-x-4">
				<button class="bg-espresso text-white px-4 py-2 rounded-3xl hover:bg-espresso/80 cursor-pointer transition-all duration-250">View Projects</button>
				<button class="border border-espresso text-caramel px-4 py-2 rounded-3xl hover:bg-caramel hover:text-white transition-all duration-250 cursor-pointer">Contact Me</button>
			</div>
		</div>

		<div class="mt-8">
			<img src="/profile-pic.jpg" alt="Hero Image" class="w-full max-w-md mx-auto rounded-[50%] shadow-lg" />
		</div>
	</div>
</BaseLayout>

<script>
	import Typed from "typed.js";
	import gsap from 'gsap';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(SplitText);

	new Typed("#typed-text", {
		strings: [
			'Software Engineer',
			'Web Developer',
			'Backend Developer',
			'Frontend Developer',
			'Full Stack Developer',
		],
		typeSpeed: 50,
		backSpeed: 50,
		backDelay: 1500,
		loop: true
	});

	const rotateHand = () => {
		gsap.to('#waving-hand', {
			rotation: 25,
			duration: 0.35,
			repeat: 4,
			yoyo: true,
			ease: 'power1.inOut',
			repeatDelay: 0.2
		})
	};

	setInterval(rotateHand, 5000);

	const heroTimeline = gsap.timeline();

	heroTimeline.fromTo('#header',
		{ y: -100, opacity: 0 },
		{ y: 0, opacity: 1, duration: 0.5, ease: 'power2.out' }
	);

	const splitText = new SplitText('#hero', { type: 'lines' });

	heroTimeline.fromTo(splitText.lines,
		{ y: 50, opacity: 0 },
		{ y: 0, opacity: 1, duration: 0.5, stagger: 0.6, ease: 'power2.out' }
	);
</script>